# Copy to .env and adjust if needed. No real secrets belong in this repo.
KAFKA_BROKERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
VACCINATION_TOPIC=vaccinations
MAX_BATCH_RECORDS=500
MAX_INFLIGHT_BATCHES=32
DEVICE_RATE_PER_S=0.5
DEVICE_BURST=5
RETRY_AFTER_S=30
PRODUCE_TIMEOUT_S=10
LOG_LEVEL=INFO

# Processor and database
DATABASE_URL=postgresql://root@roach-0:26257,roach-1:26257,roach-2:26257/nidh?sslmode=disable
SKEW_LIMIT_S=300
# CockroachDB 24.3+: a multi-node cluster is throttled 7 days after it is first started unless a
# licence key is set. Students qualify for the free "Enterprise Free" licence (cockroachlabs.cloud).
COCKROACH_LICENSE=
