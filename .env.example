# Copy to .env and adjust if needed. No real secrets belong in this repo.
KAFKA_BROKERS=redpanda-0:9092,redpanda-1:9092,redpanda-2:9092
VACCINATION_TOPIC=vaccinations
MAX_BATCH_RECORDS=500
MAX_INFLIGHT_BATCHES=32
DEVICE_RATE_PER_S=0.5
DEVICE_BURST=5
RETRY_AFTER_S=30
PRODUCE_TIMEOUT_S=10
LOG_LEVEL=INFO

# Processor and database
DATABASE_URL=postgresql://root@roach-0:26257,roach-1:26257,roach-2:26257/nidh?sslmode=disable
SKEW_LIMIT_S=300
# CockroachDB 24.3+: a multi-node cluster is throttled 7 days after it is first started unless a
# licence key is set. Students qualify for the free "Enterprise Free" licence (cockroachlabs.cloud).
COCKROACH_LICENSE=

# Read path (step 3)
CACHE_URL=redis://cache:6379/0
AGG_INTERVAL_S=15
LEASE_TTL_S=30
CACHE_TTL_S=45
# Grafana admin login (viewing needs no login). Choose your own; never commit .env.
GRAFANA_ADMIN_PASSWORD=change-me

# Fridge sensors (step 4)
MQTT_HOST=mosquitto
SENSOR_COUNT=160
READING_INTERVAL_S=60
SILENCE_LIMIT_S=300
WATCH_INTERVAL_S=15

# SMS (step 5)
SMS_GATEWAY_URL=http://sms-gateway:8092
SMS_MONTHLY_CAP=9000
REMINDER_INTERVAL_S=60
GATEWAY_FAIL_RATE=0.05
# Key that encrypts caregiver phone numbers. docker-compose.yml has a development key for
# synthetic data. To use your own, generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and put it here. Changing it later makes already-stored numbers unreadable.
PHONE_KEY=
